# ── Backend ─────────────────────────────────────────────────────
NODE_ENV=production       # api/lib/env.ts 会读它（决定缓存/错误详细度等分支）；生产由 systemd 设置
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_KIMI_AUTH_URL=       # Kimi OAuth server URL (e.g. https://auth.kimi.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
KIMI_AUTH_URL=            # Kimi OAuth server URL (backend)
KIMI_OPEN_URL=            # Kimi Open Platform URL (e.g. https://open.kimi.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── 哪钓 · Moonshot K3 视觉识别（服务端中转，Key 绝不进 APK/代码库） ──
MOONSHOT_API_KEY=         # platform.moonshot.cn 开通后获取；未配置时识别返回「服务未开通」
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
K3_MODEL=kimi-k3
K3_MOCK=false             # true=不真实调用 K3，返回模拟结果（仅开发/演示）

# ── 哪钓 · 计费（单位：分） ──
FISH_SPOT_PRICE_CENTS=50  # 基础档单次识别向用户收取（免费次数用完后）
FISH_SPOT_FREE_LIMIT=3    # 基础档前 N 次免费（拉新钩子）
FISH_SPOT_EXPERT_PRICE_CENTS=200  # v13 QY-SPOT-007 专家报告档单价（方案建议 ¥2.00–3.00，取区间下限）
FISH_SPOT_EXPERT_FREE_LIMIT=1     # 专家报告免费体验次数（与基础档免费额度分列记账，互不挪用）

# ── 识鱼 · 计费（v15 QY-FISH-003，单位：分；与哪钓各档单价/免费额度**分列记账，互不挪用**） ──
# 余额共用 user_balance.balance_cents（同一用户同一钱包），已用免费次数各功能各列：
# fish_spot.free_used / expert_free_used / user_balance.fish_id_free_used。
FISH_ID_PRICE_CENTS=30    # 单次识鱼向用户收取（免费次数用完后）。定价 ¥0.30 < 钓点基础档 ¥0.50：
                          # 识鱼只调一次模型，钓点识别链路更长——成本口径见 ADR-0005 补充段
FISH_ID_FREE_LIMIT=3      # 前 N 次免费（拉新钩子，与钓点免费次数互不挪用）
FISH_ID_MIN_CONFIDENCE_X100=55  # 低置信阈值 ×100（55 => 0.55）：Top-1 低于它就不算"高置信"，不硬猜
                                 # （同 v13「规则未命中则降级不编造」红线）；用整数百分比是为了避开
                                 # optInt 读小数会被截断成 0 的坑。
                                 # ⚠️ 口径冲突待收敛（登记在 backlog）：唯一读这个值的是 api/kimi/fishId.ts 的
                                 # isHighConfidence()，而它**当前没有任何调用点**；真正决定界面文案的是
                                 # api/knowledge/fishSpecies.ts 的 FISH_ID_MIN_CONFIDENCE=0.55（写进兜底说明）
                                 # 与 src/pages/FishId.tsx confidenceTone 里另一个硬编码 0.55。
                                 # 所以改这个环境变量**暂时不会改变线上表现**——别把它当开关用。
# ⚠️ 识鱼与哪钓共用 MOONSHOT_API_KEY / K3_MODEL / K3_TIMEOUT_MS：**生产未配 MOONSHOT_API_KEY 时，
#    点击「识鱼」入口会拿到「识别服务暂未开通」（PRECONDITION_FAILED），而不是崩溃**。
#    入口本身默认可见（FloatingBall），要真正出结果必须先在生产 .env 配 Key。

# ── 哪钓 · 专业化链路（v13） ──
K3_TIMEOUT_MS=60000       # 基础档单次调用超时（v12 语义）
K3_STEP_TIMEOUT_MS=20000  # 专家档单步超时；两步累加=端到端预算（设计指标 P95 < 40s）
FISH_KNOWLEDGE_FILE=      # 垂类知识库规则 JSON（数组）路径；留空用代码内置规则表。
                          # 每次识别按 mtime 比对热更，解析失败保留旧表（同 SENSITIVE_WORDS_FILE 模式）

# ── 内容安全 · 阿里云图片机审（v14 帖子/评论图片，AK 绝不进 APK/代码库） ──
# 未配置 ALICLOUD_ACCESS_KEY_ID/SECRET、或未配 PUBLIC_MEDIA_BASE_URL（或 IMAGE_MODERATION_ENABLED!=true）
# 时的行为：图片照常落盘发布，同时向 reports 写一条 [系统]「待人工复核」记录进 /moderation 队列——
#   也就是「放行 + 标记待审」，**不会拒绝发帖**。这是刻意选择：现状本来没有任何图片机审，
#   贸然 fail-closed 会让未开通该服务的部署彻底发不了图（口径对照 MOONSHOT_API_KEY 未配置时的降级）。
# ⚠️ 提交方式（2026-10-06 按官方文档核实并返工过一次）：内容安全**只接受可被服务端拉取的图片 URL，
#   不支持 base64**。所以机审必然发生在落盘之后，PUBLIC_MEDIA_BASE_URL 是它的硬前提；
#   该值必须是**阿里云侧真能访问到**的公网前缀（内网/防火墙后 = 拉图失败 = 全量降级）。
# ⚠️ 启用前还差一步：签名规则与请求体形状已按文档校正并由 api/services/imageModeration.test.ts
#   （13 条，mock fetch）钉住，但**没打过真实网关**——先用一张正常图 + 一张违规图各跑一次，
#   确认第二张真回到 reject 并删掉了刚落盘的文件，再置 true。按量付费通用版约 $0.6/千次（一张图一次）。
ALICLOUD_ACCESS_KEY_ID=      # 内容安全专用 RAM 子账号 AK（最小权限，只挂 AliyunYundunGreenWebFullAccess）
ALICLOUD_ACCESS_KEY_SECRET=  # 对应 Secret
ALICLOUD_GREEN_ENDPOINT=https://green.cn-shanghai.aliyuncs.com
PUBLIC_MEDIA_BASE_URL=       # 审核服务端拉图的公网前缀，例 http://120.x.x.x:3000（无尾斜杠）；留空=机审不可用
ALICLOUD_GREEN_BIZ_TYPE=     # 控制台创建的业务线，留空=默认通用业务
ALICLOUD_GREEN_SCENES=porn,terrorism,ad
IMAGE_MODERATION_ENABLED=false   # 总开关：真实网关联调通过前保持 false（false 时的行为见上方注释）
IMAGE_MODERATION_TIMEOUT_MS=3000    # 单张图片提交超时（并行提交，一次发布的审核墙钟≈该值）
IMAGE_MODERATION_DEADLINE_MS=8000   # 整批总预算：兜底 fetch 不响应 abort，超预算转人工队列、不卡死发布

# ── 哪钓 · 充值 ──
PAY_MOCK=false            # true=充值立即到账（仅开发/演示；生产必须 false，否则成自助印钞）
