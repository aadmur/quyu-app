{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-fonts.mjs && node scripts/check-images.mjs && node scripts/check-perf-wiring.mjs && node --import tsx scripts/check-knowledge.ts && vitest run && node scripts/check-plan-coverage.mjs --strict && vite build && node scripts/check-motion-boundary.mjs && node scripts/precompress.mjs && esbuild api/boot.ts --platform=node --bundle --format=esm --outdir=dist --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist/boot.js",
    "check": "tsc -b",
    "check:knowledge": "node --import tsx scripts/check-knowledge.ts",
    "check:plan": "node scripts/check-plan-coverage.mjs",
    "verify:fishspot": "node --env-file=.env.smoke --import tsx scripts/verify-fishspot.ts",
    "verify:images": "node --env-file=.env.smoke --import tsx scripts/smoke-images.ts",
    "verify:static": "node --env-file=.env.smoke scripts/smoke-static.mjs",
    "verify:smoke": "node --env-file=.env.smoke --import tsx scripts/smoke.ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "perf:firstload": "node scripts/measure-firstload.mjs",
    "perf:coldstart": "node scripts/measure-coldstart.mjs",
    "perf:stats": "node scripts/perf-log-stats.mjs",
    "perf:order": "node --import tsx scripts/bench-order-p99.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:image-backfill": "node scripts/migrate-post-images.mjs",
    "db:image-backfill:apply": "node scripts/migrate-post-images.mjs --apply"
  },
  "dependencies": {
    "@capacitor/camera": "^7.0.5",
    "@capacitor/geolocation": "^7.1.8",
    "@hono/node-server": "^1.14.3",
    "@tanstack/react-query": "^5.90.16",
    "@trpc/client": "^11.8.1",
    "@trpc/react-query": "^11.8.1",
    "@trpc/server": "^11.8.1",
    "clsx": "^2.1.1",
    "cookie": "^1.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^13.2.0",
    "hono": "^4.8.3",
    "jose": "6.1.3",
    "lenis": "^1.3.26",
    "lucide-react": "^0.562.0",
    "mysql2": "^3.14.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.6.1",
    "react-router-dom": "^7.18.3",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@hono/vite-dev-server": "^0.19.0",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.23",
    "drizzle-kit": "^0.31.8",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "plugin-inspect-react-code": "^1.0.3",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.16"
  }
}
