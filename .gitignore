node_modules
dist
.DS_Store
# Environment variables
.env
.env.local
.env.*.local
# 本地冒烟测试环境（含数据库口令等敏感值，绝不入库）
.env.smoke
# Database
*.db
*.sqlite
*.sqlite3
# 迁移 SQL 是生产 DDL 的唯一事实源（服务器无 node_modules，迁移靠手写 SQL 逐条执行），
# 因此必须纳入版本控制；如需本地试验性迁移，请放到 db/migrations/local/ 并使用 *.local.sql
db/migrations/local/
db/migrations/*.local.sql
# TypeScript cache
*.tsbuildinfo
# Build outputs
dist/
build/
# Test coverage
coverage/
.nyc_output/
# Logs
*.log
# 冷启动性能采样落盘目录（QY-PERF-008）：logs/perf-YYYY-MM-DD.jsonl 为诊断数据，不入库
logs/

# 图片兼容副本生成脚本的临时文件
.legacy-src.tmp

# verify:handoff 解包比对用的临时目录
.handoff-tmp/
